+test "literal vector count agrees with per-record matching across block boundaries" {
+    var prng = std.Random.DefaultPrng.init(711);
+    const random = prng.random();
+    const alphabet = "aAbB_x\n\x00";
+    const patterns = [_][]const u8{ "", "a", "Ab", "x_a", "absent", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" };
+    var storage: [289]u8 = undefined;
+    for (0..48) |sample| {
+        for (&storage) |*byte| byte.* = alphabet[random.uintLessThan(usize, alphabet.len)];
+        // Include a match at every alignment, followed by a delimiter in a
+        // later vector block, then consecutive empty records.
+        const start = sample % 32;
+        @memcpy(storage[start..][0..3], "x_a");
+        @memset(storage[start + 3 .. 96], 'b');
+        storage[96] = '\n';
+        storage[97] = '\n';
+        for ([_]usize{ 0, 1, 31, 32, 33, 63, 64, 95, 96, 97, 98, 128, 289 }) |len| {
+            for ([_]u8{ '\n', 0 }) |delimiter| {
+                for (patterns) |pattern| {
+                    for ([_]bool{ false, true }) |ignore_case| {
+                        for ([_]bool{ false, true }) |word| {
+                            const literal = matcher_mod.Literal.init(pattern, ignore_case, false, word);
+                            const expected = countLiteralLinesFallback(storage[0..len], &literal, delimiter);
+                            const actual = countLiteralLines(storage[0..len], &literal, delimiter, true);
+                            const matching_only = countLiteralLines(storage[0..len], &literal, delimiter, false);
+                            try std.testing.expectEqual(expected.total, actual.total);
+                            try std.testing.expectEqual(expected.matching, actual.matching);
+                            try std.testing.expectEqual(expected.matching, matching_only.matching);
+                            try std.testing.expectEqual(expected.matching, countLiteralSelected(storage[0..len], &literal, false, delimiter));
+                            try std.testing.expectEqual(expected.total - expected.matching, countLiteralSelected(storage[0..len], &literal, true, delimiter));
+                        }
+                    }
+                }
+            }
+        }
+    }
+}

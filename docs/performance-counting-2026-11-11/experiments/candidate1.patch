+
+fn countLiteralSparse(buffer: []const u8, literal: *const matcher_mod.Literal, delimiter: u8) usize {
+    var matching: usize = 0;
+    var position: usize = 0;
+    var counted_through: usize = 0;
+    var window_start: usize = 0;
+    var candidates: usize = 0;
+    while (position < buffer.len) {
+        const found = literal.find(buffer, position) orelse break;
+        if (literal.acceptsMatchAt(buffer, found)) {
+            matching += 1;
+            const line_end = std.mem.findScalarPos(u8, buffer, found + literal.pattern.len, delimiter) orelse
+                return matching;
+            position = line_end + 1;
+            counted_through = position;
+        } else {
+            position = found + 1;
+        }
+
+        // Reconsider after each small batch, including rejected word matches.
+        // A later dense region must not inherit a decision made at file start.
+        candidates += 1;
+        if (candidates == 32) {
+            if (position - window_start < 32 * 256) {
+                // Resume at a record boundary: a rejected match can leave
+                // position inside a record, where word boundaries would differ.
+                return matching + countLiteralLines(buffer[counted_through..], literal, delimiter).matching;
+            }
+            candidates = 0;
+            window_start = position;
+        }
+    }
+    return matching;
 }
 
